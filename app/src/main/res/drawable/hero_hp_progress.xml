<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background Fill -->
    <item
        android:id="@android:id/background">
        <bitmap
            android:src="@drawable/hp_black"
            android:gravity="fill" />
    </item>

    <!-- Progress Fill -->
    <item
        android:id="@android:id/progress">
        <clip>
            <bitmap
                android:src="@drawable/hp_fill"
                android:gravity="fill" />
        </clip>
    </item>

    <!-- Art Frame -->
    <item>
        <bitmap
            android:src="@drawable/hp_frame"
            android:gravity="fill" />
    </item>
</layer-list>
